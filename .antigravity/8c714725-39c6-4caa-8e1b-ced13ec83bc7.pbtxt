    modified_response: "The following action was requested:\nView contents of file /src/components/HeaderNavbar.tsx from lines 1 to 140The action produced the following result:\nFile Path: `/src/components/HeaderNavbar.tsx`\nTotal Lines: 139\nTotal Bytes: 5395\nShowing lines 1 to 139\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React, { useState } from \'react\';\n2: import { EventLayoutProject } from \'../types\';\n3: import { PRESET_PROJECT_TEMPLATES } from \'../data/defaultVariables\';\n4: import {\n5:   Ruler,\n6:   Download,\n7:   BarChart3,\n8:   Sparkles,\n9:   Layers,\n10:   FolderOpen,\n11:   ChevronDown,\n12:   Sun,\n13:   Moon,\n14:   RotateCcw,\n15:   PlusCircle,\n16: } from \'lucide-react\';\n17: \n18: interface HeaderNavbarProps {\n19:   project: EventLayoutProject;\n20:   onOpenLandModal: () => void;\n21:   onOpenExportModal: () => void;\n22:   onToggleAnalytics: () => void;\n23:   onOpenAIAdvisor: () => void;\n24:   onLoadPreset: (preset: EventLayoutProject) => void;\n25:   onToggleBlueprint: () => void;\n26:   onClearCanvas: () => void;\n27: }\n28: \n29: export const HeaderNavbar: React.FC<HeaderNavbarProps> = ({\n30:   project,\n31:   onOpenLandModal,\n32:   onOpenExportModal,\n33:   onToggleAnalytics,\n34:   onOpenAIAdvisor,\n35:   onLoadPreset,\n36:   onToggleBlueprint,\n37:   onClearCanvas,\n38: }) => {\n39:   const [showPresetsMenu, setShowPresetsMenu] = useState(false);\n40: \n41:   return (\n42:     <header className=\"h-16 px-4 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between z-30 shrink-0 text-slate-900 dark:text-slate-100 shadow-sm\">\n43:       {/* Left Branding & Event Info */}\n44:       <div className=\"flex items-center gap-4\">\n45:         <div className=\"flex items-c