      replacement_content: "import { EstablishmentVariable, EventLayoutProject } from \'../types\';\n\nexport const DEFAULT_ESTABLISHMENT_VARIABLES: EstablishmentVariable[] = [\n  // Food & Beverage\n  {\n    id: \'fb-food-truck\',\n    name: \'Food Truck Mobile Stall\',\n    category: \'food_beverage\',\n    defaultWidth: 6,\n    defaultDepth: 3,\n    color: \'#f97316\', // orange-500\n    iconName: \'Utensils\',\n    estimatedRevenuePerDay: 1200,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Mobile food truck vehicle stall requiring 6m x 3m footprint and high power access.\',\n  },\n  {\n    id: \'fb-beverage-kiosk\',\n    name: \'Beverage & Juice Kiosk\',\n    category: \'food_beverage\',\n    defaultWidth: 3,\n    defaultDepth: 3,\n    color: \'#fb923c\', // orange-400\n    iconName: \'Coffee\',\n    estimatedRevenuePerDay: 850,\n    powerRequired: true,\n    waterRequired: true,\n    description: \'Compact 3x3m drink kiosk for coffee, boba, juices, and soft drinks.\',\n  },\n  {\n    id: \'fb-dining-tent\',\n    name: \'Covered Dining & Beer Pavilion\',\n    category: \'food_beverage\',\n    defaultWidth: 12,\n    defaultDepth: 8,\n    color: \'#ea580c\', // orange-600\n    iconName: \'Beer\',\n    estimatedRevenuePerDay: 3500,\n    powerRequired: true,\n    waterRequired: true,\n    description: \'Large shaded dining pavilion with tables and seating for 40+ attendees.\',\n  },\n\n  // Retail & Shopping\n  {\n    id: \'ret-standard-stall\',\n    name: \'Standard Retail Pop-up Tent\',\n    category: \'retail_shopping\',\n    defaultWidth: 3,\n    defaultDepth: 3,\n    color: \'#3b82f6\', // blue-500\n    iconName: \'ShoppingBag\',\n    estimatedRevenuePerDay: 600,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Standard 3x3m canopy tent for apparel, accessories, and gifts.\',\n  },\n  {\n    id: \'ret-artisan-booth\',\n    name: \'Artisan Craft & Jewelry Booth\',\n    category: \'retail_shopping\',\n    defaultWidth: 4,\n    defaultDepth: 3,\n    color: \'#2563eb\', // blue-600\n    iconName: \'Gem\',\n    estimatedRevenuePerDay: 750,\n    powerRequired: false,\n    waterRequired: false,\n    description: \'Elegantly arranged 4x3m stall for handmade crafts, art prints, and jewelry.\',\n  },\n  {\n    id: \'ret-anchor-store\',\n    name: \'Flagship Merchandise Pavilion\',\n    category: \'retail_shopping\',\n    defaultWidth: 8,\n    defaultDepth: 6,\n    color: \'#1d4ed8\', // blue-700\n    iconName: \'Store\',\n    estimatedRevenuePerDay: 2800,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Large 8x6m anchor retail store for official festival merchandise and brands.\',\n  },\n\n  // Services\n  {\n    id: \'srv-info-desk\',\n    name: \'Information & Lost-Found Desk\',\n    category: \'services\',\n    defaultWidth: 3,\n    defaultDepth: 2,\n    color: \'#06b6d4\', // cyan-500\n    iconName: \'Info\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Attendee assistance hub, maps distribution, lost and found, and wristband pickup.\',\n  },\n  {\n    id: \'srv-ticket-booth\',\n    name: \'Ticket Counter & Check-In\',\n    category: \'services\',\n    defaultWidth: 4,\n    defaultDepth: 2,\n    color: \'#0891b2\', // cyan-600\n    iconName: \'Ticket\',\n    estimatedRevenuePerDay: 5000,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Primary entry wristband scanner, cash register, and entry ticket counter.\',\n  },\n  {\n    id: \'srv-atm-station\',\n    name: \'Mobile ATM & Currency Kiosk\',\n    category: \'services\',\n    defaultWidth: 2,\n    defaultDepth: 2,\n    color: \'#0e7490\', // cyan-700\n    iconName: \'CreditCard\',\n    estimatedRevenuePerDay: 300,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Secure 2x2m cash machine enclave for event goers.\',\n  },\n\n  // Entertainment & Stages\n  {\n    id: \'ent-main-stage\',\n    name: \'Main Festival Live Stage\',\n    category: \'entertainment\',\n    defaultWidth: 16,\n    defaultDepth: 10,\n    color: \'#8b5cf6\', // purple-500\n    iconName: \'Music\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Pro audio stage with truss rigging, light towers, and backstage holding area.\',\n  },\n  {\n    id: \'ent-dj-booth\',\n    name: \'Acoustic / DJ Lounge Tent\',\n    category: \'entertainment\',\n    defaultWidth: 6,\n    defaultDepth: 6,\n    color: \'#7c3aed\', // purple-600\n    iconName: \'Radio\',\n    estimatedRevenuePerDay: 1000,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Medium 6x6m live music stage or DJ booth with ambient dance floor.\',\n  },\n\n  // Amenities & Venue Ops\n  {\n    id: \'amn-restroom-trailer\',\n    name: \'Sanitation & Restroom Trailer\',\n    category: \'amenities\',\n    defaultWidth: 6,\n    defaultDepth: 3,\n    color: \'#10b981\', // emerald-500\n    iconName: \'Bath\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: true,\n    waterRequired: true,\n    description: \'Multi-stall flush toilet trailer with washing stations.\',\n  },\n  {\n    id: \'amn-trash-recycling\',\n    name: \'Waste & Recycling Hub\',\n    category: \'amenities\',\n    defaultWidth: 3,\n    defaultDepth: 2,\n    color: \'#059669\', // emerald-600\n    iconName: \'Trash2\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: false,\n    waterRequired: false,\n    description: \'Eco-sorting waste station with compost, recycling, and landfill bins.\',\n  },\n\n  // Security & Medical\n  {\n    id: \'sec-first-aid\',\n    name: \'First Aid & Medical Station\',\n    category: \'security_medical\',\n    defaultWidth: 5,\n    defaultDepth: 4,\n    color: \'#ef4444\', // red-500\n    iconName: \'Cross\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: true,\n    waterRequired: true,\n    description: \'Emergency paramedic medical tent with patient beds and triage supplies.\',\n  },\n  {\n    id: \'sec-command-post\',\n    name: \'Security & Event HQ\',\n    category: \'security_medical\',\n    defaultWidth: 5,\n    defaultDepth: 4,\n    color: \'#dc2626\', // red-600\n    iconName: \'ShieldAlert\',\n    estimatedRevenuePerDay: 0,\n    powerRequired: true,\n    waterRequired: false,\n    description: \'Security operations center, staff radio dispatch, and perimeter monitoring.\',\n  },\n];\n\nexport const PRESET_PROJECT_TEMPLATES: EventLayoutProject[] = [\n  {\n    id: \'preset-food-craft-festival\',\n    title: \'Grand Summer Food & Retail Expo\',\n    eventDate: \'2026-08-15\',\n    hostName: \'City Events Authority\',\n    locationName: \'Central Park West Green\',\n    landDimensions: {\n      width: 80,\n      height: 60,\n      unit: \'meters\',\n      shape: \'rectangular\',\n      gridSnap: 1,\n      gridVisible: true,\n    },\n    customVariables: [],\n    legendVisible: true,\n    labelsVisible: true,\n    blueprintMode: false,\n    dimensionsVisible: true,\n    roads: [\n      {\n        id: \'road-main-avenue\',\n        name: \'Grand Central Promenade\',\n        roadType: \'main_avenue\',\n        width: 6,\n        color: \'#64748b\',\n        points: [\n          { x: 10, y: 30 },\n          { x: 70, y: 30 },\n        ],\n      },\n      {\n        id: \'road-retail-alley\',\n        name: \'Artisan North Walkway\',\n        roadType: \'pedestrian_path\',\n        width: 4,\n        color: \'#94a3b8\',\n        points: [\n          { x: 40, y: 10 },\n          { x: 40, y: 50 },\n        ],\n      },\n    ],\n    waypoints: [\n      {\n        id: \'wp-gate-a\',\n        name: \'Main North Gate (Wristbands)\',\n        type: \'main_entrance\',\n        x: 10,\n        y: 30,\n        color: \'#10b981\',\n        icon: \'LogIn\',\n        description: \'Primary public entrance with bag check.\',\n      },\n      {\n        id: \'wp-gate-b\',\n        name: \'East Exit & Shuttle Station\',\n        type: \'main_entrance\',\n        x: 70,\n        y: 30,\n        color: \'#3b82f6\',\n        icon: \'LogOut\',\n        description: \'Exit towards parking and bus drop-off.\',\n      },\n      {\n        id: \'wp-emergency-north\',\n        name: \'Emergency Gate North\',\n        type: \'emergency_exit\',\n        x: 40,\n        y: 5,\n        color: \'#ef4444\',\n        icon: \'ShieldAlert\',\n        description: \'Fire service & ambulance egress point.\',\n      },\n    ],\n    establishments: [\n      // Food Truck Alley North\n      {\n        instanceId: \'inst-ft-1\',\n        variableId: \'fb-food-truck\',\n        name: \'Taco Craze Food Truck\',\n        category: \'food_beverage\',\n        x: 15,\n        y: 20,\n        width: 6,\n        depth: 3,\n        rotation: 0,\n        color: \'#f97316\',\n        stallNumber: \'F-01\',\n        rentalFee: 450,\n      },\n      {\n        instanceId: \'inst-ft-2\',\n        variableId: \'fb-food-truck\',\n        name: \'Gourmet Burger Wagon\',\n        category: \'food_beverage\',\n        x: 23,\n        y: 20,\n        width: 6,\n        depth: 3,\n        rotation: 0,\n        color: \'#f97316\',\n        stallNumber: \'F-02\',\n        rentalFee: 450,\n      },\n      {\n        instanceId: \'inst-ft-3\',\n        variableId: \'fb-food-truck\',\n        name: \'Woodfire Pizza Cart\',\n        category: \'food_beverage\',\n        x: 31,\n        y: 20,\n        width: 6,\n        depth: 3,\n        rotation: 0,\n        color: \'#f97316\',\n        stallNumber: \'F-03\',\n        rentalFee: 450,\n      },\n      // Dining Pavilion\n      {\n        instanceId: \'inst-dining-1\',\n        variableId: \'fb-dining-tent\',\n        name: \'Central Food Court Pavilion\',\n        category: \'food_beverage\',\n        x: 18,\n        y: 8,\n        width: 12,\n        depth: 8,\n        rotation: 0,\n        color: \'#ea580c\',\n        stallNumber: \'D-10\',\n        rentalFee: 800,\n      },\n      // Retail Alley South\n      {\n        instanceId: \'inst-ret-1\',\n        variableId: \'ret-standard-stall\',\n        name: \'Vintage Apparel Tent\',\n        category: \'retail_shopping\',\n        x: 15,\n        y: 38,\n        width: 3,\n        depth: 3,\n        rotation: 0,\n        color: \'#3b82f6\',\n        stallNumber: \'R-01\',\n        rentalFee: 250,\n      },\n      {\n        instanceId: \'inst-ret-2\',\n        variableId: \'ret-standard-stall\',\n        name: \'Handcrafted Leather Goods\',\n        category: \'retail_shopping\',\n        x: 20,\n        y: 38,\n        width: 3,\n        depth: 3,\n        rotation: 0,\n        color: \'#3b82f6\',\n        stallNumber: \'R-02\',\n        rentalFee: 250,\n      },\n      {\n        instanceId: \'inst-ret-3\',\n        variableId: \'ret-artisan-booth\',\n        name: \'Custom Pottery & Art\',\n        category: \'retail_shopping\',\n        x: 25,\n        y: 38,\n        width: 4,\n        depth: 3,\n        rotation: 0,\n        color: \'#2563eb\',\n        stallNumber: \'R-03\',\n        rentalFee: 300,\n      },\n      {\n        instanceId: \'inst-ret-4\',\n        variableId: \'ret-artisan-booth\',\n        name: \'Organic Skincare & Oils\',\n        category: \'retail_shopping\',\n        x: 31,\n        y: 38,\n        width: 4,\n        depth: 3,\n        rotation: 0,\n        color: \'#2563eb\',\n        stallNumber: \'R-04\',\n        rentalFee: 300,\n      },\n      // Main Stage East\n      {\n        instanceId: \'inst-stage-1\',\n        variableId: \'ent-main-stage\',\n        name: \'Sunset Sound Main Stage\',\n        category: \'entertainment\',\n        x: 52,\n        y: 12,\n        width: 16,\n        depth: 10,\n        rotation: 0,\n        color: \'#8b5cf6\',\n        stallNumber: \'STG-1\',\n        rentalFee: 0,\n      },\n      // Operations & First Aid\n      {\n        instanceId: \'inst-med-1\',\n        variableId: \'sec-first-aid\',\n        name: \'Medic Response Tent\